# Copy to .env for `docker compose up` (never commit the real .env).
# docker-compose.yml substitutes these into each service; see
# backend/.env.example for the equivalent when running the backend
# directly (outside Docker) instead.

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=docpilot
POSTGRES_PASSWORD=docpilot
POSTGRES_DB=docpilot
POSTGRES_PORT=5432

# --- Redis --------------------------------------------------------------
REDIS_PORT=6379

# --- Backend service ------------------------------------------------------
BACKEND_PORT=8000
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Document processing (celery-worker service) ---------------------------
# "tesseract" works out of the box here — the backend/celery-worker
# images install tesseract-ocr/poppler-utils (see backend/Dockerfile).
# See apps/processing/providers.py.
DOCUMENT_OCR_PROVIDER=tesseract

# Leave empty to disable Sentry locally.
SENTRY_DSN=

# --- MinIO (document storage) ----------------------------------------------
# Also doubles as the S3 credentials the backend container uses
# (DOCUMENT_STORAGE_ACCESS_KEY/SECRET_KEY) — see docker-compose.yml.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DOCUMENT_STORAGE_ACCESS_KEY=docpilot
DOCUMENT_STORAGE_SECRET_KEY=docpilot-dev-secret
DOCUMENT_STORAGE_BUCKET=docpilot-documents
