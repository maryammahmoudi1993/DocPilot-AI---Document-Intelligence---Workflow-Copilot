# Copy to backend/.env for local development (never commit the real .env).
# config/settings/local.py reads this file automatically.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Origins the frontend is served from — must match exactly (scheme +
# host + port). See docs/adr/0003-cors-configuration.md.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://docpilot:docpilot@localhost:5432/docpilot

REDIS_URL=redis://localhost:6379/0

# --- Object storage (documents) --------------------------------------------
# Running the backend natively (not via docker-compose) against a locally
# installed MinIO — both endpoints are the same host, so
# DOCUMENT_STORAGE_PUBLIC_ENDPOINT_URL can stay empty. See
# apps/documents/storage.py and docs/adr/0004-storage-abstraction.md.
DOCUMENT_STORAGE_ENDPOINT_URL=http://localhost:9000
DOCUMENT_STORAGE_PUBLIC_ENDPOINT_URL=
DOCUMENT_STORAGE_ACCESS_KEY=docpilot
DOCUMENT_STORAGE_SECRET_KEY=docpilot-dev-secret
DOCUMENT_STORAGE_BUCKET=docpilot-documents
DOCUMENT_STORAGE_REGION=us-east-1
DOCUMENT_STORAGE_USE_PATH_STYLE=True
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=20971520
DOCUMENT_SIGNED_URL_EXPIRY_SECONDS=300

# --- Document processing (Celery pipeline) ---------------------------------
# "mock" (no system dependency) or "tesseract" (real OCR — requires the
# tesseract-ocr and poppler-utils binaries installed locally; not set by
# default here since a native, non-Docker checkout usually doesn't have
# them). See apps/processing/providers.py.
DOCUMENT_OCR_PROVIDER=mock
DOCUMENT_MIN_DIGITAL_TEXT_CHARS=20

# Leave empty to disable Sentry locally.
SENTRY_DSN=
